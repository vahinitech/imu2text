# Ignore MATLAB temporary files
*.asv
*.m~
*.mlx~
*.mat
*.fig

# Ignore Simulink autogenerated files
slprj/
*.slxc

# Ignore Python or Jupyter files
*.ipynb_checkpoints
__pycache__/

# Ignore logs and results
results/logs/
*.log

# Input patch files are applied, not tracked: their content lands in the
# source tree proper, so committing them would duplicate it.
patches/

# Ignore virtual environments
.venv/
venv/

# Ignore datasets fetched by onhw_download.py (the bundled all_*.pkl stay tracked)
*.zip
data/OnHW-*/
data/onhw-*/
data/Words500_*/
data/ICROW_*/
