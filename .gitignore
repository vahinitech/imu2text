# Ignore MATLAB temporary files
*.asv
*.m~
*.mlx~
*.mat
*.fig

# Ignore Simulink autogenerated files
slprj/
*.slxc

# Ignore Python or Jupyter files
*.ipynb_checkpoints
__pycache__/

# Ignore logs and results
results/logs/
*.log

# Model weights are regenerated from the recorded runs or published outside
# git (see AGENTS.md); predictions and tables are committed instead.
*.weights.h5
*.keras
results/ctc/*.normalization.npz

# Papers are cited, not redistributed.
*.pdf
!results/*.pdf

# Input patch files are applied, not tracked: their content lands in the
# source tree proper, so committing them would duplicate it.
patches/

# Ignore virtual environments
.venv/
venv/

# Ignore datasets fetched by imu2text/download.py (the bundled all_*.pkl stay tracked)
*.zip
data/OnHW-*/
data/onhw-*/
data/Words500_*/
data/ICROW_*/
